# ---------------------------------------------------------------------------
# PlayDate — server environment
#
# Copy to .env.local for local development. On Vercel these are set per
# environment (Development / Preview / Production) in Project Settings.
#
# NOTHING in this file is read by the browser bundle. Vite only exposes
# variables prefixed VITE_, and none of the secrets below are.
# ---------------------------------------------------------------------------

# Postgres. Use the POOLED connection string — serverless functions open a new
# connection per invocation and will exhaust a direct (unpooled) endpoint.
# Neon via the Vercel Marketplace sets this for you as DATABASE_URL.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/playdate?sslmode=require"

# 32+ random bytes, base64. Used to derive the session-token pepper.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# Public origin, used for cookie scope and strict same-origin checks.
# Vercel sets VERCEL_URL automatically for previews; this pins production.
APP_ORIGIN="https://playdate.example.com"

# Set to "true" ONLY in a throwaway environment. Enables the demo sign-in and
# the simulated identity-verification resolver. Must be false in production —
# it is the difference between a demo and a service that lies about verifying
# parents.
ALLOW_DEMO_MODE="false"

# Seeded demo families are excluded from real discovery via families.is_demo.
# This only controls whether `npm run db:seed` will write them at all.
SEED_DEMO_DATA="false"

# ---------------------------------------------------------------------------
# Not yet wired — named so the shape of the work is visible.
# ---------------------------------------------------------------------------
# IDENTITY_PROVIDER="persona"        # persona | veriff | stripe_identity
# IDENTITY_PROVIDER_API_KEY=""
# IDENTITY_PROVIDER_WEBHOOK_SECRET=""
# SMS_PROVIDER_API_KEY=""
# EMAIL_PROVIDER_API_KEY=""
# UPSTASH_REDIS_REST_URL=""          # swap for the Postgres rate limiter at scale
# UPSTASH_REDIS_REST_TOKEN=""
