{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "types": ["node"],
    "baseUrl": "."
  },
  "include": ["api", "server", "src/domain", "src/services/api.ts", "src/i18n/types.ts", "src/i18n/dict.en.ts", "src/i18n/en.common.ts", "src/i18n/en.pages.ts"]
}
